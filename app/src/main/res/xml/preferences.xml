<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="Playback">
        <ListPreference
            android:key="tts_voice"
            android:title="TTS Voice"
            android:summary="Select the text-to-speech voice"
            android:entries="@array/tts_voice_names"
            android:entryValues="@array/tts_voice_values"
            android:defaultValue="default" />
        <SeekBarPreference
            android:key="speech_rate"
            android:title="Speech Rate"
            android:summary="Adjust the speaking speed"
            android:min="50"
            android:max="200"
            android:defaultValue="100" />
        <SeekBarPreference
            android:key="speech_pitch"
            android:title="Speech Pitch"
            android:summary="Adjust the speaking pitch"
            android:min="50"
            android:max="200"
            android:defaultValue="100" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Forward/Rewind">
        <SeekBarPreference
            android:key="forward_interval"
            android:title="Forward Interval (seconds)"
            android:summary="How far to jump forward"
            android:min="5"
            android:max="60"
            android:defaultValue="30" />
        <SeekBarPreference
            android:key="rewind_interval"
            android:title="Rewind Interval (seconds)"
            android:summary="How far to jump backward"
            android:min="5"
            android:max="60"
            android:defaultValue="10" />
    </PreferenceCategory>
</PreferenceScreen>
