<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/pref_category_playback">
        <Preference
            android:key="voices"
            android:title="@string/pref_voices"
            android:summary="@string/pref_voices_summary" />
        <SeekBarPreference
            android:key="speech_rate"
            android:title="@string/pref_speech_rate"
            android:summary="@string/pref_speech_rate_summary"
            android:min="50"
            android:max="200"
            android:defaultValue="100" />
        <SeekBarPreference
            android:key="speech_pitch"
            android:title="@string/pref_speech_pitch"
            android:summary="@string/pref_speech_pitch_summary"
            android:min="50"
            android:max="200"
            android:defaultValue="100" />
        <SeekBarPreference
            android:key="announce_threshold_min"
            android:title="@string/pref_announce_threshold"
            android:summary="@string/pref_announce_threshold_summary"
            android:min="0"
            android:max="60"
            android:defaultValue="5" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_bt_category">
        <SwitchPreferenceCompat
            android:key="bt_skip_articles"
            android:title="@string/pref_bt_skip"
            android:summary="@string/pref_bt_skip_summary"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_appearance">
        <SwitchPreferenceCompat
            android:key="compact_cards"
            android:title="@string/pref_compact"
            android:summary="@string/pref_compact_summary"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_category_forward_rewind">
        <SeekBarPreference
            android:key="forward_interval"
            android:title="@string/pref_forward_interval"
            android:summary="@string/pref_forward_interval_summary"
            android:min="5"
            android:max="60"
            android:defaultValue="30" />
        <SeekBarPreference
            android:key="rewind_interval"
            android:title="@string/pref_rewind_interval"
            android:summary="@string/pref_rewind_interval_summary"
            android:min="5"
            android:max="60"
            android:defaultValue="10" />
    </PreferenceCategory>
</PreferenceScreen>
