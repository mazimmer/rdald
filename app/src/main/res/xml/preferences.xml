<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="Playback">
        <Preference
            android:key="voices"
            android:title="Voices"
            android:summary="Choose which voices may be used (all selected by default)" />
        <SeekBarPreference
            android:key="speech_rate"
            android:title="Speech Rate"
            android:summary="Adjust the speaking speed (50-200%)"
            android:min="50"
            android:max="200"
            android:defaultValue="100" />
        <SeekBarPreference
            android:key="speech_pitch"
            android:title="Speech Pitch"
            android:summary="Adjust the speaking pitch (50-200%)"
            android:min="50"
            android:max="200"
            android:defaultValue="100" />
        <SeekBarPreference
            android:key="announce_threshold_min"
            android:title="Time announcement threshold"
            android:summary="Announce total/remaining time only when longer than N minutes (0 = always)"
            android:min="0"
            android:max="60"
            android:defaultValue="5" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Bluetooth controls">
        <SwitchPreferenceCompat
            android:key="bt_skip_articles"
            android:title="Forward/rewind skips articles"
            android:summary="Bluetooth next/previous jumps to the next/previous article instead of the next paragraph"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Appearance">
        <SwitchPreferenceCompat
            android:key="compact_cards"
            android:title="Compact cards"
            android:summary="Show only titles and favicons in the lists"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Forward/Rewind">
        <SeekBarPreference
            android:key="forward_interval"
            android:title="Forward Interval"
            android:summary="Seconds to jump forward (5-60s)"
            android:min="5"
            android:max="60"
            android:defaultValue="30" />
        <SeekBarPreference
            android:key="rewind_interval"
            android:title="Rewind Interval"
            android:summary="Seconds to jump backward (5-60s)"
            android:min="5"
            android:max="60"
            android:defaultValue="10" />
    </PreferenceCategory>
</PreferenceScreen>
